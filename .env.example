# GitHub Token (von https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# PDF Management API Konfiguration
PDF_API_BASE_URL=http://hero.local:1339
PDF_API_KEY=your_pdf_api_key_here

# GitHub Repository Einstellungen
GITHUB_OWNER=Minicon-eG
GITHUB_REPO=PdfManagement

# Optional: Standard-Labels für automatisch erstellte Issues
DEFAULT_LABELS=auto-generated,pdf-error
